function draw(){ctx.clearRect(0,0,W,H);ctx.fillStyle='#080e1b';ctx.fillRect(0,0,W,H);let camX=player.x-W/2,camY=player.y-H/2;ctx.save();if(shake>0){ctx.translate(rand(-shake,shake),rand(-shake,shake));shake*=.85}let grid=48,ox=(-camX%grid+grid)%grid,oy=(-camY%grid+grid)%grid;ctx.strokeStyle='#18243a';ctx.lineWidth=1;ctx.beginPath();for(let x=ox;x<W;x+=grid){ctx.moveTo(x,0);ctx.lineTo(x,H)}for(let y=oy;y<H;y+=grid){ctx.moveTo(0,y);ctx.lineTo(W,y)}ctx.stroke();let glow=ctx.createRadialGradient(W/2,H/2,30,W/2,H/2,Math.max(W,H)*.7);glow.addColorStop(0,'#14243a22');glow.addColorStop(1,'#02040bc9');ctx.fillStyle=glow;ctx.fillRect(0,0,W,H);
