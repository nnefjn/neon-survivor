 ];
 function pickWeighted(pool,count){let chosen=[],bag=pool.slice();while(chosen.length<count&&bag.length){let total=bag.reduce((a,u)=>a+u.weight,0),r=Math.random()*total,idx=0;for(;idx<bag.length-1;idx++){r-=bag[idx].weight;if(r<=0)break}chosen.push(bag.splice(idx,1)[0])}return chosen}
 upgrades=pickWeighted(upgrades,3);$('upgradeChoices').innerHTML='';upgrades.forEach(u=>{let b=document.createElement('button');b.className='choice';b.innerHTML=`<div class="bigemoji">${u.icon}</div><b>${u.name}</b><span><strong>${u.rarity}</strong><br>${u.desc}</span>`;if(u.rarity==='Легендарне')b.style.borderColor='#ffd66b';else if(u.rarity==='Епічне')b.style.borderColor='#c084fc';else if(u.rarity==='Рідкісне')b.style.borderColor='#53f5e9';b.onclick=()=>{u.fn();paused=false;running=true;$('overlay').classList.add('hidden');$('start').classList.remove('hidden');say(u.rarity.toUpperCase()+': '+u.name);last=performance.now();requestAnimationFrame(loop);updateHud()};$('upgradeChoices').append(b)});updateHud()}
