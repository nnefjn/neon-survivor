addEventListener('keydown',e=>{keys[e.code]=true;if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.code))e.preventDefault();if(e.code==='Space'&&running&&dashCD<=0){dash=.16;dashCD=weapon.dashCD||2;burst(player.x,player.y,'#53f5e9',14)}if(e.code==='Escape'&&running){running=false;paused=true;$('overlay').classList.remove('hidden');$('start').classList.remove('hidden');$('upgradeArea').classList.add('hidden');$('endArea').classList.add('hidden');$('start').textContent='ПРОДОВЖИТИ ▶'}});addEventListener('keyup',e=>keys[e.code]=false);canvas.addEventListener('mousemove',e=>{mouse.x=e.clientX;mouse.y=e.clientY});canvas.addEventListener('mousedown',e=>{if(e.button===0)mouse.down=true});addEventListener('mouseup',e=>{if(e.button===0)mouse.down=false});canvas.addEventListener('contextmenu',e=>e.preventDefault());$('start').onclick=()=>{if(paused&&player&&player.hp>0){paused=false;running=true;$('overlay').classList.add('hidden');last=performance.now();requestAnimationFrame(loop)}else start()};$('restart').onclick=()=>start();
