for(let e of foes){let p=pos(e);ctx.save();ctx.shadowBlur=e.isBoss?34:20;ctx.shadowColor=e.color;ctx.fillStyle=e.hit>0?'white':e.color;ctx.beginPath();if(e.isBoss){ctx.moveTo(p.x,p.y-e.r);ctx.lineTo(p.x+e.r*.82,p.y-e.r*.35);ctx.lineTo(p.x+e.r,p.y+e.r*.35);ctx.lineTo(p.x,p.y+e.r);ctx.lineTo(p.x-e.r,p.y+e.r*.35);ctx.lineTo(p.x-e.r*.82,p.y-e.r*.35);ctx.closePath()}else ctx.arc(p.x,p.y,e.r,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;ctx.fillStyle='#101322';ctx.beginPath();ctx.arc(p.x-e.r*.3,p.y-e.r*.15,e.isBoss?5:2.5,0,7);ctx.arc(p.x+e.r*.3,p.y-e.r*.15,e.isBoss?5:2.5,0,7);ctx.fill();ctx.fillStyle='#293047';ctx.fillRect(p.x-e.r,p.y-e.r-12,e.r*2,5);ctx.fillStyle=e.isBoss?'#ff315d':'#6dffb0';ctx.fillRect(p.x-e.r,p.y-e.r-12,e.r*2*clamp(e.hp/e.maxHp,0,1),5);if(e.isBoss){ctx.fillStyle='#fff';ctx.font='bold 12px system-ui';ctx.textAlign='center';ctx.fillText(e.isFinal?'ОСТАННІЙ БОС':'БОС',p.x,p.y-e.r-18)}ctx.restore()}
let pp={x:W/2,y:H/2};let aim=worldPos(mouse.x,mouse.y),ang=Math.atan2(aim.y-player.y,aim.x-player.x);ctx.save();ctx.translate(pp.x,pp.y);ctx.rotate(ang);ctx.shadowBlur=24;ctx.shadowColor='#53f5e9';ctx.fillStyle=player.invuln>0&&Math.floor(elapsed*18)%2?'#ffffff':'#53f5e9';ctx.beginPath();ctx.moveTo(19,0);ctx.lineTo(-11,-11);ctx.lineTo(-7,0);ctx.lineTo(-11,11);ctx.closePath();ctx.fill();ctx.fillStyle='#eaffff';ctx.fillRect(2,-3,19,6);ctx.restore();if(dashCD>0){ctx.strokeStyle='#53f5e955';ctx.lineWidth=2;ctx.beginPath();ctx.arc(W/2,H/2,23,0,Math.PI*2*dashCD/2);ctx.stroke()}for(let p of particles){let q=pos(p);ctx.globalAlpha=clamp(p.life/p.max,0,1);ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(q.x,q.y,p.r,0,7);ctx.fill()}ctx.globalAlpha=1;ctx.restore();let vg=ctx.createRadialGradient(W/2,H/2,Math.min(W,H)*.25,W/2,H/2,Math.max(W,H)*.72);vg.addColorStop(0,'transparent');vg.addColorStop(1,'#02040b88');ctx.fillStyle=vg;ctx.fillRect(0,0,W,H)}
