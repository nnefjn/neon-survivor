function update(dt){elapsed+=dt;wave=1+Math.floor(elapsed/24);spawnT-=dt;shootT-=dt;dashCD-=dt;player.invuln-=dt;if(toastT>0)toastT-=dt;else $('toast').textContent='';if(mouse.down)shoot();
