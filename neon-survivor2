for(let i=foes.length-1;i>=0;i--){let e=foes[i],a=Math.atan2(player.y-e.y,player.x-e.x);if(!e.isBoss||dist(e,player)>155){e.x+=Math.cos(a)*e.speed*dt;e.y+=Math.sin(a)*e.speed*dt}e.hit=Math.max(0,e.hit-dt);if(dist(e,player)<e.r+player.r){if(player.invuln<=0){player.hp-=e.damage;player.invuln=.65;shake=9;burst(player.x,player.y,'#ff577e',10);if(player.hp<=0){player.hp=0;updateHud();endGame();return}}}}
